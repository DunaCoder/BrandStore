// Configuración básica
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS (Para estandarizar opciones) ---

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// --- MODELOS ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?   // Opcional si usas Google Auth después
  image         String?
  role          Role      @default(USER)
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  price       Float
  images      String[]    // Next.js maneja muy bien arrays de strings para galerías
  stock       Int         @default(0)
  isVisible   Boolean     @default(true)
  
  // Relación con Categoría
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  
  // Relación con Items de pedidos (histórico)
  orderItems  OrderItem[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  shippingAddress String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  priceAtPurchase Float // Crucial: Si el precio del producto sube, el pedido viejo mantiene este precio
}